{
  "name": "caishen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:worktree": "node --import tsx scripts/worktree-database.ts create",
    "db:worktree:delete": "node --import tsx scripts/worktree-database.ts delete",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed-dev.ts",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --ignore-path .gitignore --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --ignore-path .gitignore --cache",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:e2e:cleanup": "node --import tsx scripts/cleanup-e2e.ts",
    "typecheck": "tsc --noEmit",
    "video:render": "remotion render src/video/index.ts OgVideo public/og/caishen.mp4 --codec=h264 --pixel-format=yuv420p --muted && remotion still src/video/index.ts OgVideo public/og/caishen.png --frame=205",
    "video:studio": "remotion studio src/video/index.ts",
    "test": "node --import tsx --import ./tests/change-set-oracle.ts --test tests/domain/*.test.ts tests/integrations/*.test.ts tests/server/*.test.ts && npm run test:components",
    "test:components": "vitest run",
    "test:domain": "node --import tsx --import ./tests/change-set-oracle.ts --test tests/domain/*.test.ts",
    "test:services": "node --import tsx --import ./tests/change-set-oracle.ts --test tests/integrations/*.test.ts tests/server/*.test.ts",
    "test:db": "node --env-file=.env.local --import tsx --import ./tests/change-set-oracle.ts --test --test-concurrency=1 tests/database/*.test.ts",
    "benchmark:rows": "node --import tsx scripts/benchmark-rows.ts",
    "test:sandbox": "node --env-file=.env.local --import tsx --test tests/sandbox/*.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.5",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@next/env": "^15.5.28",
    "@prisma/client": "^6.19.3",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dialkit": "^2.0.2",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "next": "^15.5.28",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.2.4",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/testing": "^2.2.47",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "14.2.35",
    "@playwright/test": "^1.64.1",
    "@remotion/cli": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "8.20.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.28",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.19.3",
    "remotion": "4.0.533",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      ".": "$@next/eslint-plugin-next",
      "glob": "^13.0.6"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "next": {
      "postcss": "$postcss"
    }
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
