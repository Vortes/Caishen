{
  "name": "caishen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed-dev.ts",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --ignore-path .gitignore --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --ignore-path .gitignore --cache",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/domain/*.test.ts tests/integrations/*.test.ts tests/server/*.test.ts",
    "test:domain": "node --import tsx --test tests/domain/*.test.ts",
    "test:services": "node --import tsx --test tests/integrations/*.test.ts tests/server/*.test.ts",
    "test:db": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/database/*.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.5",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@next/env": "^15.5.28",
    "@prisma/client": "^6.19.3",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "fast-json-patch": "^3.1.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "next": "^15.5.28",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.47",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "14.2.35",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dialkit": "^2.0.2",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      ".": "$@next/eslint-plugin-next",
      "glob": "^13.0.6"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "next": {
      "postcss": "$postcss"
    }
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
