generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model CrudItem {
  id          String   @id @default(cuid())
  clerkUserId String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId, createdAt])
}

model Workspace {
  id         String            @id @default(cuid())
  revision   Int               @default(0)
  book       Json
  history    Json              @default("{}")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  members    WorkspaceMember[]
  operations BudgetOperation[]
  invites    PartnerInvite[]
}

model WorkspaceMember {
  clerkUserId String    @id
  user        User      @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model BudgetOperation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operationId String
  actorId     String
  actor       User      @relation(fields: [actorId], references: [clerkUserId], onDelete: Restrict)
  source      String
  type        String
  commandHash String
  revision    Int
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, operationId])
  @@index([workspaceId, actorId, createdAt])
}

model PartnerInvite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   String
  creator     User      @relation("InviteCreator", fields: [createdBy], references: [clerkUserId], onDelete: Restrict)
  expiresAt   DateTime
  usedBy      String?
  recipient   User?     @relation("InviteRecipient", fields: [usedBy], references: [clerkUserId], onDelete: Restrict)
  createdAt   DateTime  @default(now())
}

model BankConnection {
  id              String    @id @default(cuid())
  clerkUserId     String
  user            User      @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  itemId          String    @unique
  encryptedToken  String
  cursor          String?
  imports         Json
  accountMappings Json
  lastSyncedAt    DateTime?
  lastAttemptAt   DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clerkUserId])
}

model ReviewEvidence {
  id          String   @id @default(cuid())
  clerkUserId String
  user        User     @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  accountId   String
  kind        String
  cutoff      String
  evidence    Json
  result      Json
  createdAt   DateTime @default(now())

  @@index([clerkUserId, accountId, createdAt])
}

model DailyDelivery {
  id             String    @id @default(cuid())
  clerkUserId    String
  user           User      @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  localDate      String
  status         String
  leaseUntil     DateTime
  error          String?
  sentAt         DateTime?
  providerId     String?
  scheduledAt    DateTime?
  payload        Json?
  firstAttemptAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([clerkUserId, localDate])
}

model User {
  id              String              @id @default(cuid())
  clerkUserId     String              @unique
  firstName       String?
  lastName        String?
  imageUrl        String?
  primaryEmail    String?
  active          Boolean             @default(true)
  clerkUpdatedAt  BigInt?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  memberships     WorkspaceMember[]
  operations      BudgetOperation[]
  bankConnections BankConnection[]
  evidence        ReviewEvidence[]
  deliveries      DailyDelivery[]
  invitesCreated  PartnerInvite[]     @relation("InviteCreator")
  invitesUsed     PartnerInvite[]     @relation("InviteRecipient")
  webhookEvents   ClerkWebhookEvent[]
}

model ClerkWebhookEvent {
  id          String   @id
  clerkUserId String
  user        User     @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  type        String
  occurredAt  DateTime
  payloadHash String
  applied     Boolean
  createdAt   DateTime @default(now())

  @@index([clerkUserId, occurredAt])
}
