generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model CrudItem {
  id          String   @id @default(cuid())
  clerkUserId String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId, createdAt])
}

model Workspace {
  id                 String              @id @default(cuid())
  revision           Int                 @default(0)
  // Browsers holding an older revision download every row again: the
  // household changed shape or rows were removed outright (ADR 0006).
  resetRevision      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  members            WorkspaceMember[]
  invites            PartnerInvite[]
  // Rows (ADR 0006). Read and written only through src/server/storage.
  budgetMembers      Member[]
  partnerEntries     PartnerEntry[]
  partnerSettlements PartnerSettlement[]
  partnerRequests    PartnerRequest[]
  operationLog       Operation[]
}

model WorkspaceMember {
  clerkUserId String    @id
  user        User      @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model PartnerInvite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   String
  creator     User      @relation("InviteCreator", fields: [createdBy], references: [clerkUserId], onDelete: Restrict)
  expiresAt   DateTime
  usedBy      String?
  recipient   User?     @relation("InviteRecipient", fields: [usedBy], references: [clerkUserId], onDelete: Restrict)
  createdAt   DateTime  @default(now())
}

model BankConnection {
  id              String    @id @default(cuid())
  clerkUserId     String
  user            User      @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  itemId          String    @unique
  encryptedToken  String
  cursor          String?
  imports         Json
  accountMappings Json
  unavailableAccountIds String[] @default([])
  status          String    @default("connected")
  consentExpiresAt       DateTime?
  lastSuccessfulUpdateAt DateTime?
  lastFailedUpdateAt     DateTime?
  newAccountsAvailable   Boolean   @default(false)
  updateRequestedAt      DateTime?
  lastSyncedAt    DateTime?
  lastAttemptAt   DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bankAccounts          BankAccount[]

  @@index([clerkUserId])
}

// The audit trail of every exchange with Plaid (spec #139): each request the
// adapter makes, each webhook received, and each Link success or exit.
// `method` names what happened: the Plaid endpoint, the webhook type and
// code, or the Link outcome. Holds ids and outcomes only, never tokens,
// account numbers, or bodies. Not tied to BankConnection or User rows: an
// investigation of a removed connection still needs its trail, so the daily
// job purges rows past the retention window instead of a cascade.
model BankProviderEvent {
  id           String   @id @default(cuid())
  kind         String
  method       String
  requestId    String?
  errorCode    String?
  connectionId String?
  clerkUserId  String?
  durationMs   Int?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([connectionId, createdAt])
  @@index([clerkUserId, createdAt])
  @@index([createdAt])
}

// One provider account inside one bank connection (ADR 0009): Plaid's
// account id, the persistent id when Plaid provides one, the account's
// details and balances, its state, and its readiness (historyComplete, which
// replaces the connection's synchronizedAccountIds list). status is text whose
// values only grow: shared, unavailable, revoked, retired. A row Plaid
// reported again under a new id points at the row that took its place.
// This release reads these rows and still writes the connection's JSON
// lists; the writer release copies the lists into rows.
// The migration also adds a partial unique index Prisma cannot express:
// (connectionId, persistentAccountId) WHERE status = 'shared' AND
// persistentAccountId IS NOT NULL.
model BankAccount {
  id                  String           @id @default(cuid())
  connectionId        String
  connection          BankConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerAccountId   String
  persistentAccountId String?
  name                String
  officialName        String?
  mask                String?
  type                String
  subtype             String?
  currency            String?
  currentBalance      Decimal?         @db.Decimal(20, 4)
  availableBalance    Decimal?         @db.Decimal(20, 4)
  balancesAsOf        DateTime?
  status              String           @default("shared")
  historyComplete     Boolean          @default(false)
  firstSeenAt         DateTime         @default(now())
  lastSeenAt          DateTime         @default(now())
  supersededById      String?
  supersededBy        BankAccount?     @relation("BankAccountSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  superseded          BankAccount[]    @relation("BankAccountSupersession")
  link                BankAccountLink?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([connectionId, providerAccountId])
  @@index([supersededById])
}

// One feed from a provider account into a budget account (ADR 0009): the
// Account or Loan row named by the budget's composite key, the import start
// date, the opening snapshot (the same shape as accountMappings'), and when
// the feed began and ended. The budget columns carry no foreign key: a link
// may feed a Loan as well as an Account, and both are soft-deleted rows the
// budget keeps forever, so the row's existence is the engine's to check.
// The migration adds a partial unique index Prisma cannot express:
// (workspaceId, userId, accountId) WHERE unlinkedAt IS NULL, so a budget
// account has at most one live feed.
model BankAccountLink {
  id              String      @id @default(cuid())
  bankAccountId   String      @unique
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  workspaceId     String
  userId          String
  accountId       String
  startDate       String
  openingSnapshot Json?
  linkedAt        DateTime    @default(now())
  unlinkedAt      DateTime?

  @@index([workspaceId, userId, accountId])
}

model ReviewEvidence {
  id          String   @id @default(cuid())
  clerkUserId String
  user        User     @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  accountId   String
  kind        String
  cutoff      String
  evidence    Json
  result      Json
  createdAt   DateTime @default(now())

  @@index([clerkUserId, accountId, createdAt])
}

model DailyDelivery {
  id             String    @id @default(cuid())
  clerkUserId    String
  user           User      @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  localDate      String
  status         String
  leaseUntil     DateTime
  error          String?
  sentAt         DateTime?
  providerId     String?
  scheduledAt    DateTime?
  payload        Json?
  firstAttemptAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([clerkUserId, localDate])
}

model User {
  id              String              @id @default(cuid())
  clerkUserId     String              @unique
  firstName       String?
  lastName        String?
  imageUrl        String?
  primaryEmail    String?
  active          Boolean             @default(true)
  inviteChecks    Int                 @default(0)
  inviteWindow    DateTime?
  clerkUpdatedAt  BigInt?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  memberships     WorkspaceMember[]
  bankConnections BankConnection[]
  evidence        ReviewEvidence[]
  deliveries      DailyDelivery[]
  invitesCreated  PartnerInvite[]     @relation("InviteCreator")
  invitesUsed     PartnerInvite[]     @relation("InviteRecipient")
  webhookEvents   ClerkWebhookEvent[]
  operationLog    Operation[]
}

model ClerkWebhookEvent {
  id          String   @id
  clerkUserId String
  user        User     @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Restrict)
  type        String
  occurredAt  DateTime
  payloadHash String
  applied     Boolean
  createdAt   DateTime @default(now())

  @@index([clerkUserId, occurredAt])
}

// Personal budgets and household data as rows (ADR 0006). One table per row
// table in src/domain/rows.ts, read and written only through the data-access
// layer in src/server/storage (enforced by lint). Every row carries the
// household revision at which it last changed and a deletion flag; rows are
// never removed while browsers may still need to learn of the deletion.
// Amounts are cents. Kinds and statuses are text: stored values only grow
// (ADR 0006), and the engine validates them.

model Member {
  workspaceId  String
  userId       String
  name         String
  sort         Int
  revision     Int
  deleted      Boolean            @default(false)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  settings     BudgetSettings?
  accounts     Account[]
  groups       CategoryGroup[]
  categories   Category[]
  income       ExpectedIncome[]
  transactions Transaction[]
  loans        Loan[]
  rules        Rule[]
  bankImports  BankImport[]
  payees       PayeeMemory[]
  partnerSides PartnerEntrySide[]

  @@id([workspaceId, userId])
  @@index([workspaceId, revision])
}

model BudgetSettings {
  workspaceId  String
  userId       String
  startMonth   String
  timezone     String
  emailEnabled Boolean
  emailHour    Int
  revision     Int
  deleted      Boolean @default(false)
  member       Member  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([workspaceId, revision])
}

model Account {
  workspaceId       String
  userId            String
  id                String
  name              String
  kind              String
  openingBalance    BigInt
  date              String
  reconciledDate    String?
  reconciledBalance BigInt?
  sort              Int
  revision          Int
  deleted           Boolean @default(false)
  member            Member  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([workspaceId, userId, id])
  @@index([workspaceId, revision])
}

model CategoryGroup {
  workspaceId String
  userId      String
  name        String
  sort        Int
  revision    Int
  deleted     Boolean @default(false)
  member      Member  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([workspaceId, userId, name])
  @@index([workspaceId, revision])
}

model Category {
  workspaceId           String
  userId                String
  id                    String
  name                  String
  group                 String
  pairedAccountId       String?
  pairedLoanId          String?
  // A paired envelope: the counterparty account whose cash it holds.
  counterpartyAccountId String?
  sort                  Int
  revision              Int
  deleted               Boolean      @default(false)
  member                Member       @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  target                Target?
  assignments           Assignment[]

  @@id([workspaceId, userId, id])
  @@index([workspaceId, revision])
}

model Target {
  workspaceId   String
  userId        String
  categoryId    String
  cadence       String
  behavior      String
  amount        BigInt
  startMonth    String
  dueDate       String?
  weekday       Int?
  monthDay      Int?
  repeatEvery   Int?
  repeatUnit    String?
  snoozedMonths String[]
  revision      Int
  deleted       Boolean  @default(false)
  category      Category @relation(fields: [workspaceId, userId, categoryId], references: [workspaceId, userId, id], onDelete: Cascade)

  @@id([workspaceId, userId, categoryId])
  @@index([workspaceId, revision])
}

// One per budget category and month, holding the month's total.
model Assignment {
  workspaceId String
  userId      String
  categoryId  String
  month       String
  id          String
  amount      BigInt
  sort        Int
  revision    Int
  deleted     Boolean  @default(false)
  category    Category @relation(fields: [workspaceId, userId, categoryId], references: [workspaceId, userId, id], onDelete: Cascade)

  @@id([workspaceId, userId, categoryId, month])
  @@index([workspaceId, revision])
}

model ExpectedIncome {
  workspaceId String
  userId      String
  month       String
  amount      BigInt
  revision    Int
  deleted     Boolean @default(false)
  member      Member  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([workspaceId, userId, month])
  @@index([workspaceId, revision])
}

model Transaction {
  workspaceId                 String
  userId                      String
  id                          String
  accountId                   String
  date                        String
  amount                      BigInt
  payee                       String
  status                      String
  categoryId                  String?
  expenseMonth                String
  providerId                  String?
  // The transaction's own revision, which its history entries record.
  transactionRevision         Int
  reviewed                    Boolean
  kind                        String
  linkedId                    String?
  counterpartyShare           Json?
  linkedCounterpartyAccountId String?
  counterpartyName            String?
  partnerSettlementId         String?
  removed                     Boolean?
  // YNAB's C column. Rows saved before it are cleared once posted.
  cleared                     Boolean?
  reconciled                  Boolean?
  sort                        Int
  revision                    Int
  deleted                     Boolean              @default(false)
  member                      Member               @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  history                     TransactionHistory[]
  lines                       TransactionLine[]

  @@id([workspaceId, userId, id])
  @@index([workspaceId, revision])
}

// Keyed by the entry's position: combining records repeats revisions.
model TransactionHistory {
  workspaceId         String
  userId              String
  transactionId       String
  sequence            Int
  transactionRevision Int
  amount              BigInt
  status              String
  date                String
  payee               String
  operationId         String
  reason              String
  combinedId          String?
  actorId             String?
  at                  String?
  shareChanges        Json?
  revision            Int
  deleted             Boolean     @default(false)
  transaction         Transaction @relation(fields: [workspaceId, userId, transactionId], references: [workspaceId, userId, id], onDelete: Cascade)

  @@id([workspaceId, userId, transactionId, sequence])
  @@index([workspaceId, revision])
}

// One line of a split transaction: part of its amount in one category.
model TransactionLine {
  workspaceId       String
  userId            String
  transactionId     String
  id                String
  categoryId        String?
  amount            BigInt
  counterpartyShare Json?
  sort              Int
  revision          Int
  deleted           Boolean     @default(false)
  transaction       Transaction @relation(fields: [workspaceId, userId, transactionId], references: [workspaceId, userId, id], onDelete: Cascade)

  @@id([workspaceId, userId, transactionId, id])
  @@index([workspaceId, revision])
}

model Loan {
  workspaceId    String
  userId         String
  id             String
  name           String
  categoryId     String
  principal      BigInt
  minimumPayment BigInt
  variable       Boolean
  sort           Int
  revision       Int
  deleted        Boolean       @default(false)
  member         Member        @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  rates          LoanRate[]
  payments       LoanPayment[]

  @@id([workspaceId, userId, id])
  @@index([workspaceId, revision])
}

model LoanRate {
  workspaceId   String
  userId        String
  loanId        String
  sequence      Int
  effectiveDate String
  annualRateBps Int
  revision      Int
  deleted       Boolean @default(false)
  loan          Loan    @relation(fields: [workspaceId, userId, loanId], references: [workspaceId, userId, id], onDelete: Cascade)

  @@id([workspaceId, userId, loanId, sequence])
  @@index([workspaceId, revision])
}

model LoanPayment {
  workspaceId String
  userId      String
  loanId      String
  id          String
  date        String
  principal   BigInt
  interest    BigInt
  sort        Int
  revision    Int
  deleted     Boolean @default(false)
  loan        Loan    @relation(fields: [workspaceId, userId, loanId], references: [workspaceId, userId, id], onDelete: Cascade)

  @@id([workspaceId, userId, loanId, id])
  @@index([workspaceId, revision])
}

model Rule {
  workspaceId    String
  userId         String
  id             String
  fromCategoryId String
  toCategoryId   String
  enabled        Boolean
  sort           Int
  revision       Int
  deleted        Boolean @default(false)
  member         Member  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([workspaceId, userId, id])
  @@index([workspaceId, revision])
}

// One bank connection's import state for one logical bank transaction: its
// stored import, how it was resolved, its error, and its review evidence.
// The connection's own details stay on BankConnection. Not tied to the
// connection row: removing a connection first marks its imports deleted,
// and those deleted rows stay so browsers learn of the removal.
model BankImport {
  workspaceId  String
  userId       String
  connectionId String
  logicalId    String
  record       Json?
  resolved     Json?
  error        String?
  reviews      Json?
  sort         Int
  revision     Int
  deleted      Boolean @default(false)
  member       Member  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([workspaceId, userId, connectionId, logicalId])
  @@index([workspaceId, revision])
  @@index([connectionId])
}

// Every operation applied to a household. The command and its change set
// are kept for a limited time (for retries and undo); the rest is kept
// forever so a retried operation is never applied twice.
model Operation {
  workspaceId String
  operationId String
  actorId     String
  source      String
  type        String
  inputHash   String
  revision    Int
  createdAt   DateTime  @default(now())
  command     Json?
  changeSet   Json?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorId], references: [clerkUserId], onDelete: Restrict)

  @@id([workspaceId, operationId])
  @@index([workspaceId, revision])
  @@index([workspaceId, actorId, revision])
  @@index([createdAt])
}

// A payee's most recent categorization, by its normalized payee key.
model PayeeMemory {
  workspaceId       String
  userId            String
  payeeKey          String
  payee             String
  kind              String
  categoryId        String?
  counterpartyShare Json?
  revision          Int
  deleted           Boolean @default(false)
  member            Member  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([workspaceId, userId, payeeKey])
  @@index([workspaceId, revision])
}

// The partner ledger both budgets share: one entry per purchase or refund
// line shared between the partners, holding only its ledger facts.
model PartnerEntry {
  workspaceId         String
  id                  String
  payerId             String
  sourceTransactionId String?
  sourceLineId        String?
  sourceHasPurposeCategory Boolean?
  sourceOnSplitPurchase Boolean?
  date                String
  payee               String
  status              String
  amount              BigInt
  share               BigInt
  removed             Boolean?
  history             Json
  sort                Int
  revision            Int
  deleted             Boolean   @default(false)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, id])
  @@index([workspaceId, revision])
}

// One partner's private side of a partner ledger entry: their category.
model PartnerEntrySide {
  workspaceId String
  userId      String
  entryId     String
  categoryId  String?
  revision    Int
  deleted     Boolean @default(false)
  member      Member  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([workspaceId, userId, entryId])
  @@index([workspaceId, revision])
}

// Settling up between the partners: one payment from one partner to the
// other, holding only its ledger facts. Each partner's leg of it is a
// transaction in their own budget.
model PartnerSettlement {
  workspaceId String
  id          String
  payerId     String
  date        String
  amount      BigInt
  method      String
  confirmed   Boolean
  removed     Boolean?
  history     Json
  sort        Int
  revision    Int
  deleted     Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, id])
  @@index([workspaceId, revision])
}

// One partner asking the other to pay an amount.
model PartnerRequest {
  workspaceId String
  id          String
  requesterId String
  date        String
  amount      BigInt
  sort        Int
  revision    Int
  deleted     Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, id])
  @@index([workspaceId, revision])
}
