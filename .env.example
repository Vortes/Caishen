# connect_timeout covers a Neon compute waking from scale to zero.
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require&connect_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Optional live integrations; leave blank until configured.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Allowlist this exact URL in Plaid Dashboard > Developers > API > Redirect URIs.
# Production requires HTTPS on your app's domain, ending in /banks/oauth.
PLAID_REDIRECT_URI="http://localhost:3000/banks/oauth"
BANK_TOKEN_ENCRYPTION_KEY=""
RESEND_API_KEY=""
EMAIL_FROM=""
APP_BASE_URL=""
CRON_SECRET=""
# The Healthchecks.io check the daily job pings; leave blank to skip.
HEALTHCHECKS_PING_URL=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# Development and test tooling only; the running app reads none of these.
# The Neon project that holds development data, for `npm run db:worktree`,
# `npm run db:seed`, the database tests, and E2E. These are ids from the Neon
# console, not credentials. A database on localhost needs none of them.
NEON_PROJECT_ID=""
# A non-default branch named dev-caishen, and its read-write endpoint.
NEON_DEVELOPMENT_BRANCH_ID=""
NEON_DEVELOPMENT_ENDPOINT_ID=""
# The branch production runs on. The tooling refuses to touch it.
NEON_PRODUCTION_BRANCH_ID=""
# Written by `npm run db:worktree`; names the branch the URLs above point at.
NEON_BRANCH=""
# The development Clerk user ids `npm run db:seed` gives the demo household.
DEV_SEED_USER_ID=""
DEV_SEED_PARTNER_ID=""
# Plaid Sandbox keys for `npm run test:sandbox`.
PLAID_SANDBOX_CLIENT_ID=""
PLAID_SANDBOX_SECRET=""
